# /etc/systemd/system/ctp-md-stop-night-late.timer
# OPTIONAL: 02:45 stop for products whose night session runs past 23:00
# (SHFE/INE metals and energy). Enable only with matching NIGHT windows in
# /etc/xtrader/ctp-md.env, and disable ctp-md-stop-night.timer.
[Unit]
Description=Late night-session stop for CTP market data capture (SHFE metals)

[Timer]
OnCalendar=Tue..Sat *-*-* 02:45:00 Asia/Shanghai
Persistent=false
RandomizedDelaySec=0
Unit=ctp-md-ctl@stop-late-night.service

[Install]
WantedBy=timers.target
