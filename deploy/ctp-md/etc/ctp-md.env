# ctp-md scheduler policy. No secrets belong here: credentials stay encrypted
# in /etc/xtrader/market.enc. Times are Asia/Shanghai, enforced by the units.
# Source: user daemonization request, 2026-11-25.
ENABLE_DAY=1
ENABLE_NIGHT=1

# Start windows: the scheduler only starts the service inside these windows.
DAY_START_WINDOW=08:30-13:00
NIGHT_START_WINDOW=20:30-22:30

# Presence windows: health keeps the service alive while inside one of them.
DAY_PRESENT_WINDOW=08:30-15:20
NIGHT_PRESENT_WINDOW=20:30-23:05

# Tick windows: staleness is only enforced while ticks are actually expected.
# Day window deliberately skips the 10:15/11:30 breaks; night window is a single
# range and may cross midnight for SHFE metals (e.g. 21:00-02:35).
DAY_TICK_WINDOW=09:00-11:30,13:30-15:20
NIGHT_TICK_WINDOW=21:00-23:05

# No tick for this long inside a tick window triggers a restart (health only
# acts after this session already received at least one tick).
STALE_SECS_DAY=600
STALE_SECS_NIGHT=600

# Status file must refresh within this many seconds, or the daemon is stuck.
STATUS_MAX_AGE_SECS=90
# Login/subscribe is allowed this long before health declares it failed.
START_GRACE_SECS=600
# Upper bound on health-triggered restarts per hour (avoids boot loops).
RESTART_LIMIT_PER_HOUR=5

# Written by xtrader_market_capture --daemon-tick (XTRADER_MARKET_STATE_DIR).
STATUS_FILE=/var/lib/xtrader/market/daemon.status
